{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@devlife/api-client": ["../../packages/api-client/src/index.ts"],
      "@devlife/types": ["../../packages/types/src/index.ts"]
